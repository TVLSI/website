{% set contextTitle = title or person.title %}

{% set eicYears = "" %}
{% if person.eic and person.eic.start and person.eic.end %}
  {% set eicYears = person.eic.start ~ "-" ~ person.eic.end %}
{% endif %}

{% set yearsFromTitle = "" %}
{% if contextTitle %}
  {% set yearsFromTitle = contextTitle.replace("Editor-in-Chief", "").trim() %}
{% endif %}

{# Prefer structured years; fall back to years parsed from title #}
{% set pastEicYears = "" %}
{% if eicYears %}
  {% set pastEicYears = eicYears %}
{% elseif yearsFromTitle and yearsFromTitle.search('\\d') != -1 %}
  {% set pastEicYears = yearsFromTitle %}
{% endif %}

{% set isPastEic = false %}
{% if contextTitle and contextTitle.indexOf("Editor-in-Chief") == 0 and pastEicYears %}
  {% set isPastEic = true %}
{% endif %}

{% set tileTitle = contextTitle %}
{% set cardTitle = contextTitle %}
{% if isPastEic %}
  {% set tileTitle = pastEicYears %}
  {% set cardTitle = "Editor-in-Chief " ~ pastEicYears %}
{% elseif contextTitle and contextTitle.indexOf("Editor-in-Chief") == 0 and eicYears %}
  {% set cardTitle = "Editor-in-Chief " ~ eicYears %}
{% endif %}

{% set roleLabel = contextTitle %}
{% if contextTitle and contextTitle.indexOf("Editor-in-Chief") == 0 %}
  {% set roleLabel = "Editor-in-Chief" %}
{% endif %}

{% set showHomepageLink = person.homepage and contextTitle != "Associate Editor" and contextTitle != "Editorial Assistant" %}

{% set personImage = person.img_src or "images/cs.jpg" %}

<div class="person-tile" onclick="showModal('{{ id }}')">
  {% if isPastEic and tileTitle %}
    <div class="person-role person-role-top">{{ tileTitle }}</div>
  {% endif %}
  <img src="{{ site.baseUrl }}/{{ personImage }}" alt="{{ person.first_name }} {{ person.last_name }}">
  <div class="person-info">
    <strong>{{ person.first_name }} {{ person.last_name }}</strong>
    {% if roleLabel %}
      <div class="person-role">{{ roleLabel }}</div>
    {% endif %}
    {% if person.organizations and person.organizations.length > 0 %}
      <div class="organization org-group">
        <span class="org-name">{{ person.organizations[0].name }}</span>
        <span class="org-country">{{ person.organizations[0].country }}</span>
      </div>
    {% endif %}
    {% if person.emails %}
      <div class="organization">
        <svg class="link-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
          <path fill="currentColor" d="M464 64H48C21.5 64 0 85.5 0 112v288c0 26.5 21.5 48 48 48h416c26.5 0 48-21.5 48-48V112c0-26.5-21.5-48-48-48zM48 96h416c8.8 0 16 7.2 16 16v41.4c-21.9 18.5-53.2 44-150.6 121.3-16.9 13.4-50.2 45.7-73.4 45.3-23.2.4-56.6-31.9-73.4-45.3C85.2 197.4 53.9 171.9 32 153.4V112c0-8.8 7.2-16 16-16zm416 320H48c-8.8 0-16-7.2-16-16V195c22.8 18.7 58.8 47.6 130.7 104.7 20.5 16.4 56.7 52.5 93.3 52.3 36.4.3 72.3-35.5 93.3-52.3 71.9-57.1 107.9-86 130.7-104.7v205c0 8.8-7.2 16-16 16z"></path>
        </svg>
        <a href="mailto:{{ person.emails[0] }}" class="email-link" onclick="event.stopPropagation()">Email</a>
      </div>
    {% endif %}
    {% if showHomepageLink %}
      <div class="organization">
        <svg class="link-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 496 512">
          <path fill="currentColor" d="M336.5 160C322 70.7 287.8 8 248 8s-74 62.7-88.5 152h177zM152 256c0 22.2 1.2 43.5 3.3 64h185.3c2.1-20.5 3.3-41.8 3.3-64s-1.2-43.5-3.3-64H155.3c-2.1 20.5-3.3 41.8-3.3 64zm324.7-96c-28.6-67.9-86.5-120.4-158-141.6 24.4 33.8 41.2 84.7 50 141.6h108zM177.2 18.4C105.8 39.6 47.8 92.1 19.3 160h108c8.7-56.9 25.5-107.8 49.9-141.6zM487.4 192H372.7c2.1 21 3.3 42.5 3.3 64s-1.2 43-3.3 64h114.6c5.5-20.5 8.6-41.8 8.6-64s-3.1-43.5-8.5-64zM120 256c0-21.5 1.2-43 3.3-64H8.6C3.2 212.5 0 233.8 0 256s3.2 43.5 8.6 64h114.6c-2-21-3.2-42.5-3.2-64zm39.5 96c14.5 89.3 48.7 152 88.5 152s74-62.7 88.5-152h-177zm159.3 141.6c71.4-21.2 129.4-73.7 158-141.6h-108c-8.8 56.9-25.6 107.8-50 141.6zM19.3 352c28.6 67.9 86.5 120.4 158 141.6-24.4-33.8-41.2-84.7-50-141.6h-108z"></path>
        </svg>
        <a href="{{ person.homepage }}" class="website-link" target="_blank" rel="noopener" onclick="event.stopPropagation()">Homepage</a>
      </div>
    {% endif %}
  </div>
</div>

<div id="{{ id }}" class="modal-overlay" onclick="closeModal('{{ id }}')">
  <div class="modal-content" onclick="event.stopPropagation()">
    <span class="modal-close" onclick="closeModal('{{ id }}')">&times;</span>
    
    <div class="person-card">
      <div class="person-flex">
        <div class="person-photo">
          <img src="{{ site.baseUrl }}/{{ personImage }}" alt="{{ person.first_name }} {{ person.last_name }}">
          
          <div class="person-links">
            {% if person.emails %}
              {% for email in person.emails %}
              <a href="mailto:{{ email }}" class="email-link">
                <svg class="link-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
                  <path fill="currentColor" d="M464 64H48C21.5 64 0 85.5 0 112v288c0 26.5 21.5 48 48 48h416c26.5 0 48-21.5 48-48V112c0-26.5-21.5-48-48-48zM48 96h416c8.8 0 16 7.2 16 16v41.4c-21.9 18.5-53.2 44-150.6 121.3-16.9 13.4-50.2 45.7-73.4 45.3-23.2.4-56.6-31.9-73.4-45.3C85.2 197.4 53.9 171.9 32 153.4V112c0-8.8 7.2-16 16-16zm416 320H48c-8.8 0-16-7.2-16-16V195c22.8 18.7 58.8 47.6 130.7 104.7 20.5 16.4 56.7 52.5 93.3 52.3 36.4.3 72.3-35.5 93.3-52.3 71.9-57.1 107.9-86 130.7-104.7v205c0 8.8-7.2 16-16 16z"></path>
                </svg> Email
              </a>
              {% endfor %}
            {% endif %}
            {% if showHomepageLink %}
              <a href="{{ person.homepage }}" class="website-link" target="_blank" rel="noopener">
                <svg class="link-icon" aria-hidden="true" focusable="false" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 496 512">
                  <path fill="currentColor" d="M336.5 160C322 70.7 287.8 8 248 8s-74 62.7-88.5 152h177zM152 256c0 22.2 1.2 43.5 3.3 64h185.3c2.1-20.5 3.3-41.8 3.3-64s-1.2-43.5-3.3-64H155.3c-2.1 20.5-3.3 41.8-3.3 64zm324.7-96c-28.6-67.9-86.5-120.4-158-141.6 24.4 33.8 41.2 84.7 50 141.6h108zM177.2 18.4C105.8 39.6 47.8 92.1 19.3 160h108c8.7-56.9 25.5-107.8 49.9-141.6zM487.4 192H372.7c2.1 21 3.3 42.5 3.3 64s-1.2 43-3.3 64h114.6c5.5-20.5 8.6-41.8 8.6-64s-3.1-43.5-8.5-64zM120 256c0-21.5 1.2-43 3.3-64H8.6C3.2 212.5 0 233.8 0 256s3.2 43.5 8.6 64h114.6c-2-21-3.2-42.5-3.2-64zm39.5 96c14.5 89.3 48.7 152 88.5 152s74-62.7 88.5-152h-177zm159.3 141.6c71.4-21.2 129.4-73.7 158-141.6h-108c-8.8 56.9-25.6 107.8-50 141.6zM19.3 352c28.6 67.9 86.5 120.4 158 141.6-24.4-33.8-41.2-84.7-50-141.6h-108z"></path>
                </svg> Website <span class="fa fa-external-link" aria-hidden="true"></span>
              </a>
            {% endif %}
          </div>
        </div>

        <div>
          {% if cardTitle %}
            <div class="person-role-title">{{ cardTitle }}</div>
          {% endif %}
          <h3>{{ person.first_name }} {{ person.last_name }}</h3>

          {% if person.organizations and person.organizations.length > 0 %}
          <div class="person-org-list no-indent">
            {% for org in person.organizations %}
            {% if org.url %}
              <p><a href="{{ org.url }}" target="_blank" rel="noopener">{{ org.name }}</a><span class="fa fa-external-link" aria-hidden="true"></span></p>
            {% else %}
              <p>{{ org.name }}</p>
            {% endif %}
            
            <p>{{ org.department }}</p>
            {% if org.location and org.country %}
              <p>{{ org.location }}, {{ org.country }}</p>
            {% elseif org.location %}
              <p>{{ org.location }}</p>
            {% elseif org.country %}
              <p>{{ org.country }}</p>
            {% endif %}
            {% if not loop.last %}<br>{% endif %}
            {% endfor %}
          </div>
          {% endif %}

          {% if person.location %}
          <p>{{ person.location }}</p>
          {% endif %}

            {% if person.interests and person.interests.length > 0 %}
            <p class="section-label">Research Interests:</p>
            <ul class="person-org-list">
            {% for interest in person.interests %}
            <li>{{ interest }}</li>
            {% endfor %}
            </ul>
            {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
